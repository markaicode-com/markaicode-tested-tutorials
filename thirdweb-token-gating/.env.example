# the domain your app runs on
NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN=localhost:3000
# client id from the thirdweb dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# a private key used only to sign login tokens (JWT); it needs no funds. Never commit it.
THIRDWEB_ADMIN_PRIVATE_KEY=
# your ERC-721 membership NFT contract on Base
NFT_CONTRACT_ADDRESS=
